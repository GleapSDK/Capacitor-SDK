      {
        "name": "setColorScheme",
        "signature": "(options: { colorScheme: 'default' | 'auto' | 'light' | 'dark'; lightBackgroundColor?: string; darkBackgroundColor?: string; }) => Promise<{ colorScheme: string; }>",
        "parameters": [
          {
            "name": "options",
